# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OPENAI_API_KEY: Your OpenAI API key for gpt-4o-mini bid generation
OPENAI_API_KEY="your_openai_api_key_here"

# FREELANCER_OAUTH_TOKEN: Your Freelancer.com OAuth Bearer Token
FREELANCER_OAUTH_TOKEN="your_freelancer_oauth_token_here"

# AUTOBID_CONFIG_JSON: Optional JSON string of your full filter configuration to persist across cloud/Render container redeployments
AUTOBID_CONFIG_JSON=""


# ADMIN_PASSWORD: Bootstraps the first admin account (email = ADMIN_EMAIL, default admin@local)
# on first boot only. After that, manage admins from the Admin page's Users tab.
ADMIN_PASSWORD="choose-a-long-password"

# ADMIN_EMAIL: Email for the auto-created admin account. Optional, defaults to "admin@local".
ADMIN_EMAIL="you@example.com"

# SESSION_SECRET: Signs login sessions and encrypts stored secrets. Any random string, 32+ characters.
# Changing it signs everyone out and makes previously stored secrets unreadable.
SESSION_SECRET="replace-with-32-plus-random-characters"

# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: Optional. Enables "Continue with Google" sign-in.
# Create a free OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <your-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# AUTOBID_DB_PATH: Optional override for the SQLite file location. Defaults to data/autobid.db.
AUTOBID_DB_PATH=""
